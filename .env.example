# This port will be used by Makefile
PORT=8000
DEBUG=true
REGISTRY_NAMESPACE=melora-fullstack:latest

# Public domain routed to this stack by the homelab caddy (caddy-docker-proxy).
# Required by docker-compose.yml (caddy labels) whenever the stack is composed;
# set it to the real domain for the deploy target.
MELORA_DOMAIN=melora.example.com

# Redis
REDIS_PORT=6379

# Google OAuth (required for login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend URL (for OAuth redirect)
FRONTEND_URL=http://localhost:5173

# JWT Secret (generate a random string for production)
JWT_SECRET_KEY=change-me-in-production-use-a-random-secret
