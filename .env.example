# This port will be used by Makefile
PORT=8000
DEBUG=true
REGISTRY_NAMESPACE=melora-fullstack:latest

# Public domain routed to this stack by the homelab caddy (caddy-docker-proxy).
# Only required by docker-compose.prod.yml (caddy labels). Not used by the
# local dev docker-compose.yml, which runs with no reverse proxy.
MELORA_DOMAIN=melora.example.com

# Postgres (docker-compose.yml runs its own `postgres` service on this port)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=melora
POSTGRES_PASSWORD=melora
POSTGRES_DB=melora

# Redis
REDIS_PORT=6379

# Google OAuth (required for login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend URL (for OAuth redirect)
FRONTEND_URL=http://localhost:5173

# JWT Secret (generate a random string for production)
JWT_SECRET_KEY=change-me-in-production-use-a-random-secret

# If set, this email is granted the admin role on startup (idempotent) and the
# deploy script also ensures it after every deploy. Used to bootstrap the
# first admin without an existing admin in the system.
ROOT_ADMIN_EMAIL=

# Bug reporter widget (screenshot + annotated bug reports). When false (default)
# the /api/v1/bugs endpoints are not registered. The frontend is gated by
# VITE_ENABLE_BUGREPORTER=true at build time.
ENABLE_BUGREPORTER=false
