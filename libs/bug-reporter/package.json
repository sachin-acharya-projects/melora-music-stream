{
    "name": "@sachin-acharya-projects/bug-reporter",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Self-contained bug reporter widget: capture, annotate and submit annotated screenshots to any backend.",
    "license": "MIT",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "files": ["dist", "src"],
    "sideEffects": false,
    "scripts": {
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "dependencies": {
        "html-to-image": "^1.11.11"
    },
    "devDependencies": {
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react-swc": "^4.2.2",
        "typescript": "~5.9.3",
        "vite": "^7.3.1"
    }
}
