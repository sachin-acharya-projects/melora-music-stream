#!/bin/bash
# melora-deploy — production deployment script for Melora.
#
# INSTALLED ON THE SERVER at /usr/local/sbin/melora-deploy (root-owned) and
# invoked by the CI workflow (.github/workflows/deploy.yml) as:
#     sudo -n /usr/local/sbin/melora-deploy
# The CI runner connects as the restricted deploy account (github-deploy) and
# sudoes to root. The sudoers rule scopes this to that single command:
#     github-deploy ALL=(root) NOPASSWD: /usr/local/sbin/melora-deploy
#
# WHAT THE SERVER NEEDS (prerequisites)
#   - Docker with the compose plugin (`docker compose`), a running registry:2
#     on this host, and the shared homelab Postgres reachable on the external
#     db_net network (the app auto-runs `alembic upgrade head` on startup).
#   - docker-compose.prod.yml is delivered by the CI workflow, not git: the
#     runner uploads it to /tmp/melora-docker-compose.prod.yml (via
#     `tailscale ssh`); this script installs it into $PROJECT as root. There
#     is NO git checkout on the server — the compose file pulls the app image
#     from the private registry (REGISTRY_HOST/REGISTRY_IMAGE via
#     REGISTRY_NAMESPACE, served over HTTPS by the homelab caddy) instead of
#     building locally.
#   - No .env file: the CI workflow builds one from GitHub Secrets and pipes it
#     on STDIN. This script writes it (0600), deploys, then removes it again so
#     secrets never linger on disk (guaranteed by the EXIT trap).
#
# DEPLOYMENT FLOW (what this script does)
#   0. Consume the injected .env from stdin; derive PROJECT from its
#      MELORA_PROJECT_DIR (fallback /opt/melora).
#   1. Validate prerequisites (docker, compose, non-empty .env on stdin with the
#      required keys).
#   2. Install the docker-compose.prod.yml uploaded by CI (staged at
#      /tmp/melora-docker-compose.prod.yml) as $PROJECT/docker-compose.prod.yml.
#   3. Write the injected .env (0600) into $PROJECT.
#   4. Pull the app images (image refs resolved from .env via compose).
#   5. Recreate & start the stack (melora-fullstack, redis).
#   6. Health-check the API and the SPA container-internally (no host ports).
#   7. Prune old docker images, then remove the .env.
#
# NOTE: after a deploy there is deliberately no .env left in $PROJECT. The
# running containers keep their env; to run `docker compose` manually on the
# server, recreate the .env (e.g. from .env.production) or export the vars,
# and pass `-f docker-compose.prod.yml`.

set -euo pipefail

# --- 0. Consume the injected .env from stdin exactly once ---
# The CI workflow builds it from GitHub Secrets and pipes it here. Read it into
# memory now so the project dir (MELORA_PROJECT_DIR) can be extracted from it
# before the file is written in step 3.
INJECTED="$(cat)"
[ -n "$INJECTED" ] || die "empty .env received on stdin"

# Project directory: from the injected .env, else the shell env (testing), else
# a neutral fallback the script creates as root.
PROJECT="$(printf '%s\n' "$INJECTED" | sed -n 's/^MELORA_PROJECT_DIR=//p' | tail -n1)"
PROJECT="${PROJECT:-${MELORA_PROJECT_DIR:-/opt/melora}}"
ENV_FILE="$PROJECT/.env"
# MELORA_DOMAIN is a required key (validated in step 3); used for messaging.
MELORA_DOMAIN_VALUE="$(printf '%s\n' "$INJECTED" | sed -n 's/^MELORA_DOMAIN=//p' | tail -n1)"

log()  { printf '🚀 \033[1;32m%s\033[0m\n' "$*"; }
die()  { printf '❌ \033[1;31m%s\033[0m\n' "$*" >&2; exit 1; }

cleanup() {
    if [ -f "$ENV_FILE" ]; then
        rm -f "$ENV_FILE"
        log "Post-deploy cleanup: removed $ENV_FILE"
    fi
}
trap cleanup EXIT

# --- 1. Prerequisites ---
command -v docker >/dev/null 2>&1 || die "docker is not installed"
docker compose version >/dev/null 2>&1 || die "docker compose plugin is not installed"
mkdir -p "$PROJECT"
[ -d "$PROJECT" ] || die "could not create project dir: $PROJECT"
[ -f "$PROJECT/docker-compose.prod.yml" ] || [ -f /tmp/melora-docker-compose.prod.yml ] || \
    die "no docker-compose.prod.yml in $PROJECT and none uploaded (expected /tmp/melora-docker-compose.prod.yml)"

# --- 2. Install the uploaded docker-compose.prod.yml ---
if [ -f /tmp/melora-docker-compose.prod.yml ]; then
    log "Installing docker-compose.prod.yml from /tmp/melora-docker-compose.prod.yml..."
    install -m 0644 /tmp/melora-docker-compose.prod.yml "$PROJECT/docker-compose.prod.yml"
    rm -f /tmp/melora-docker-compose.prod.yml
fi
[ -f "$PROJECT/docker-compose.prod.yml" ] || die "docker-compose.prod.yml not found in $PROJECT"
# A leftover dev compose file from a pre-split deploy must not shadow the
# production one, since it carries host-port bindings.
rm -f "$PROJECT/docker-compose.yml"

# --- 3. Write the injected .env ---
log "Writing .env from CI (GitHub Secrets)..."
umask 077
printf '%s\n' "$INJECTED" > "$ENV_FILE"
chmod 600 "$ENV_FILE"
for key in REGISTRY_NAMESPACE MELORA_DOMAIN JWT_SECRET_KEY POSTGRES_PASSWORD; do
    grep -q "^${key}=" "$ENV_FILE" || die "required key '$key' missing from injected .env"
done

cd "$PROJECT"

# --- 4. Pull the app images (image refs resolved from .env via compose) ---
log "Pulling app images from the private registry..."
docker compose -f docker-compose.prod.yml --env-file "$ENV_FILE" pull

# --- 5. Recreate & start the stack (redis/db managed by compose) ---
log "Recreating Melora stack..."
docker compose -f docker-compose.prod.yml --env-file "$ENV_FILE" up -d --remove-orphans

# --- 6. Health checks (container-internal) ---
# The stack publishes no host ports: the app is only reachable through the
# caddy reverse proxy on proxy_net (MELORA_DOMAIN). So instead of curling
# localhost:PORT, exec into the container and hit its nginx (port 80), which
# proxies /api/v1 to the backend on localhost:8000.
log "Health-checking the API (container-internal)..."
API_OK=0
for _ in $(seq 1 30); do
    if docker exec melora-fullstack curl -sf -o /dev/null http://localhost/api/v1/openapi.json; then
        API_OK=1
        break
    fi
    sleep 2
done
[ "$API_OK" = 1 ] || die "API did not become healthy inside melora-fullstack"

log "Health-checking the SPA (container-internal)..."
SPA_OK=0
for _ in $(seq 1 10); do
    if docker exec melora-fullstack curl -sf -o /dev/null http://localhost/; then
        SPA_OK=1
        break
    fi
    sleep 2
done
[ "$SPA_OK" = 1 ] || die "SPA did not become healthy inside melora-fullstack"

# --- 7. Housekeeping ---
log "Pruning old docker images..."
docker image prune -f >/dev/null

log "Deployment completed!"
log "App is running at https://${MELORA_DOMAIN_VALUE:-<MELORA_DOMAIN>}"
